{
  "DatabaseProvider": "MySQL",
  "ConnectionStrings": {
    "MySQL": "Server=localhost;Port=3306;Database=blog_bank;User=root;Password=root;CharSet=utf8mb4;",
    "PostgreSQL": "Host=localhost;Port=5432;Database=blog_bank;Username=postgres;Password=root;"
  },
  "Jwt": {
    "SecretKey": "your-256-bit-secret-key-here-change-in-production",
    "Issuer": "BlogBank",
    "Audience": "BlogBank",
    "AccessTokenExpireMinutes": 500,
    "RefreshTokenExpireDays": 7
  },
  "Redis": {
    "Enabled": true,
    "ConnectionString": "127.0.0.1:6379"
  },
  "Cache": {
    "Enabled": true,
    "DefaultExpirySeconds": 300,
    "Articles": 600,
    "Essays": 600,
    "Users": 120,
    "Roles": 600,
    "Menus": 600,
    "UserRoles": 120,
    "UserMenus": 120
  },
  "Seed": {
    "Enabled": false,
    "AdminRole": {
      "Code": "admin",
      "Name": "管理员",
      "Description": "系统管理员，拥有所有权限"
    },
    "SuperAdmin": {
      "Username": "superadmin",
      "Nickname": "超级管理员",
      "Email": "superadmin@example.com",
      "Password": "Admin@123",
      "Avatar": ""
    }
  },
  "AutoMigrate": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Queues": [
      {
        "Exchange":       "export.exchange",
        "DeadExchange":   "export.dlx",
        "Queue":          "export",
        "DeadQueue":      "export.dead",
        "RoutingKey":     "export.job",
        "DeadRoutingKey": "export.dead"
      },
      {
        "Exchange":       "audit.exchange",
        "DeadExchange":   "audit.dlx",
        "Queue":          "audit",
        "DeadQueue":      "audit.dead",
        "RoutingKey":     "audit.log",
        "DeadRoutingKey": "audit.dead"
      }
    ,
      {
        "Exchange":       "taskJob.exchange",
        "DeadExchange":   "taskJob.dlx",
        "Queue":          "taskJob",
        "DeadQueue":      "taskJob.dead",
        "RoutingKey":     "taskJob.log",
        "DeadRoutingKey": "taskJob.dead"
      }
    ]
  }
}
